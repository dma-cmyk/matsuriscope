# MatsuriScope 設定例 (.env にコピーして使用)

# サーバーポート
PORT=8787

# DBファイルパス (デフォルト: <root>/data/matsuriscope.db)
# DB_FILE=./data/matsuriscope.db

# 収集間隔 (分) — 初期値 30
COLLECT_INTERVAL_MINUTES=30

# 外部リクエスト間隔 (ミリ秒) — 5chに負荷をかけないため最低500ms
COLLECT_REQUEST_DELAY_MS=2000

# 1ジョブあたりの巡回板数上限
COLLECT_MAX_BOARDS=40

# 板あたりの取得スレッド数上限 (勢い上位)
COLLECT_MAX_THREADS_PER_BOARD=5

# 1ジョブあたりのdat取得数上限
COLLECT_MAX_DAT=60

# HTTPタイムアウト (ミリ秒)
HTTP_TIMEOUT_MS=20000

# 収集時の User-Agent
# USER_AGENT=MatsuriScope/0.1 (+local research app; contact: localhost)

# サーバー起動時に即座に1回収集する (1=有効)
# COLLECT_ON_START=1
