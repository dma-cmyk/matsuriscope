{
  "name": "matsuriscope",
  "version": "0.1.0",
  "private": true,
  "description": "MatsuriScope — 5ch人気スレッドの画像・動画を発見するメディアリサーチアプリ",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @matsuriscope/server run dev",
    "dev:web": "pnpm --filter @matsuriscope/web run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @matsuriscope/server run start",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  }
}
